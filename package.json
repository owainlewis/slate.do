{
  "name": "slate.do",
  "version": "0.0.0",
  "private": true,
  "description": "A card-first control plane for human and agent work.",
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "dev:web": "vite --config web/vite.config.mts",
    "build:web": "vite build --config web/vite.config.mts",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test:react": "vitest run --config web/vitest.config.mts",
    "verify:browser": "playwright --version",
    "test:web": "npm run typecheck:web && npm run test:react",
    "test:browser": "npm run build:web && node --test --test-concurrency=1 --test-timeout=600000 web/tests/editor.browser.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owainlewis/slate.do.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/owainlewis/slate.do/issues"
  },
  "homepage": "https://github.com/owainlewis/slate.do#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/castoro": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
